	<!-- Player states -->
	<string id="st_ui_main_sensor">
		<text>%c[0,255,255,255]輻射\n
		%c[ui_gray_2]此屬性在GAMMA中沒有作用, 看到此文字說明您啟用了某些額外的UI類mod
		</text>
	</string>
	<string id="ui_inv_burn_protection">
		<text>%c[0,255,255,255]灼燒抗性\n
		%c[ui_gray_2]此項屬性是角色抵禦火系異常的指標:\n
		%c[0,255,255,255]防護策略:\n
		%c[d_cyan] • %c[0,255,255,255]裝備: %c[ui_gray_2]防護服\腰帶裝備\護甲\神器 \n</text> 
	</string>
	<string id="ui_inv_chemical_burn_protection">
		<text>%c[0,255,255,255]生化抗性\n
		%c[ui_gray_2]此項屬性是角色抵禦生化系異常的指標:\n
		%c[0,255,255,255]防護策略:\n
		%c[d_cyan] • %c[0,255,255,255]物品: %c[ui_gray_2]金黴素, 磺胺抗菌藥, 解毒劑\n
		%c[d_cyan] • %c[0,255,255,255]裝備: %c[ui_gray_2]防護服\腰帶裝備\護甲\神器\n</text>
	</string>
	<string id="ui_inv_fire_wound_protection">
		<text>%c[0,255,255,255]防彈效能\n
		%c[ui_gray_2]此項屬性是角色護甲能安全吸收子彈或彈片動能的指標, 出於評估目的, 使用了國際公認的美國國家司法研究所(NIJ)系統:\n\n
		%c[d_cyan] • %c[ui_gray_2] 護甲等級表:\n
		%c[d_cyan] • %c[ui_gray_2] 無:%c[ui_gray_2] 9x18mm, .45 ACP, 12x76\n
		%c[d_cyan] • %c[ui_gray_2] 等級 I:%c[ui_gray_2] 9x18mm +P+, 9x19mm FMJ, 9x19mm JHP, 手雷彈片\n
		%c[d_cyan] • %c[ui_gray_2] 等級 IIA 和 II:%c[ui_gray_2] 9x18mm RG028, .45 HS, 5.7x28mm SS195, .357 HP, 12x76獨頭彈\n
		%c[d_cyan] • %c[ui_gray_2] 等級 IIIA:%c[ui_gray_2] 9x19mm AP, 5.45x39mm FMJ/EP, 5.56x45mm FMJ, 7.62x51mm北約彈, 9x39mm SP-5, 12x76鏢彈\n
		%c[d_cyan] • %c[ui_gray_2] 等級 III:%c[ui_gray_2] 5.56x45mm EP/AP, 7.62x39mm FMJ/AP, 7.62x54mm ZN1/PP, 7.92x57mm毛瑟彈, 9x39mm SP-6, 12.7x55mm STs-130\n
		%c[d_cyan] • %c[ui_gray_2] 等級 IV:%c[ui_gray_2] 5.45x39mm AP, 7.62x51mm北約AP彈, 7.62x54mm AP/7H14, 7.92x57mm SA, .338拉普阿馬格南, 12.7x55mm STs-130 VPS\n
		%c[d_cyan] • %c[ui_gray_2] 等級 V (外骨骼):%c[d_red] 軍事機密\n
		%c[0,255,255,255]注意:\n
		%c[ui_gray_2]上述防護等級只涉及護甲的反穿透屬性, 由於動能傳遞, 子彈的衝擊仍然能夠造成鈍傷</text>
	</string>
	<string id="ui_inv_radiation_protection">
		<text>%c[0,255,255,255]輻射抗性\n
		%c[ui_gray_2]此項屬性是角色抵禦輻射的指標:\n
		%c[0,255,255,255]防護策略:\n
		%c[d_cyan] • %c[0,255,255,255]物品: %c[ui_gray_2]消輻寧, 抗輻射針, 碘化鉀片, 輻射防護片, AI-2急救包, 科研用急救包, "重生"針劑, 科研用治療針, 小型生存包\n
		%c[d_cyan] • %c[0,255,255,255]裝備: %c[ui_gray_2]防護服\腰帶裝備\頭盔或面罩\神器</text>
	</string>
	<string id="ui_inv_shock_protection">
		<text>%c[0,255,255,255]電擊抗性\n
		%c[ui_gray_2]此項屬性是角色抵禦電系異常的指標:\n
		%c[0,255,255,255]防護策略:\n
		%c[d_cyan] • %c[0,255,255,255]物品: %c[ui_gray_2]防護服\腰帶裝備\護甲\神器\n</text>
	</string>
	<string id="ui_inv_telepatic_protection">
		<text>%c[0,255,255,255]靈能抗性\n
		%c[ui_gray_2]此項屬性是角色抵禦靈能場的指標:\n
		%c[0,255,255,255]防護策略:\n
		%c[d_cyan] • %c[0,255,255,255]物品: %c[ui_gray_2]依託拉嗪鎮靜藥, 抗靈藥, 安眠藥, 大麻捲煙, 一包大麻\n</text>
	</string>
	<string id="ui_inv_wound_protection">
		<text>%c[0,255,255,255]撕裂抗性\n
		%c[ui_gray_2]此項屬性代表了角色的護甲吸收和轉移各種物理衝擊的能力, 包括但不限於拳擊, 踢擊, 刺擊, 割傷, 咬傷和靈能投擲的各種物體碎片\n
		%c[0,255,255,255]防護策略:\n
		%c[d_cyan] • %c[0,255,255,255]物品: %c[ui_gray_2]防護服\腰帶裝備\護甲\神器\n</text>
	</string>
	<string id="ui_inv_power_restore">
		<text>%c[0,255,255,255]體力恢復\n
		%c[ui_gray_2]此屬性在GAMMA中沒有作用, 看到此文字說明您啟用了某些額外的UI類mod\n</text>
	</string>
