		<text>清除所有標記 - 此操作無法撤銷</text>
	</string>

	<string id = "ui_mcm_pawsys_pawbinds_bind_wptoggle">
		<text>切換顯示路點按鍵</text>
	</string>

	<string id = "ui_mcm_pawsys_pawbinds_bind_wptoggle_desc">
		<text>按下此鍵, 會隱藏/顯示目前的路點</text>
	</string>

	<string id = "ui_mcm_pawsys_pawbinds_bind_quickpin">
		<text>快速標記按鍵</text>
	</string>

	<string id = "ui_mcm_pawsys_pawbinds_bind_quickpin_desc">
		<text>按下此鍵, 會在玩家最近的智慧地形上放置標記, 如果同時安裝了快速旅行平衡模組(FFT), 則此標記可作為快速旅行用途</text>
	</string>

	<string id = "ui_mcm_pawsys_pawbinds_bind_cartmode">
		<text>製圖模式按鍵</text>
	</string>

	<string id = "ui_mcm_pawsys_pawbinds_bind_cartmode_desc">
		<text>預設為長按, 此功能會啟用製圖模式, 能夠顯示所有智慧地形(GAMMA中預設關閉), 並有額外的工具和選項來使玩家更方便的管理標記</text>
	</string>

	<string id ="ui_mcm_pawsys_pawpins_use_custom_pin_icon">
		<text>使用自定義的mapspot圖示來顯示地圖示記</text>
	</string>

	<string id ="ui_mcm_pawsys_pawpins_use_custom_pin_icon_desc">
