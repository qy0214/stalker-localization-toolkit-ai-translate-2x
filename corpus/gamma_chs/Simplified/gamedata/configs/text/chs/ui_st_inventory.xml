	<!-- Player states -->
	<string id="st_ui_main_sensor">
		<text>%c[0,255,255,255]辐射\n
		%c[ui_gray_2]此属性在GAMMA中没有作用, 看到此文本说明您启用了某些额外的UI类mod
		</text>
	</string>
	<string id="ui_inv_burn_protection">
		<text>%c[0,255,255,255]灼烧抗性\n
		%c[ui_gray_2]此项属性是角色抵御火系异常的指标:\n
		%c[0,255,255,255]防护策略:\n
		%c[d_cyan] • %c[0,255,255,255]装备: %c[ui_gray_2]防护服\腰带装备\护甲\神器 \n</text> 
	</string>
	<string id="ui_inv_chemical_burn_protection">
		<text>%c[0,255,255,255]生化抗性\n
		%c[ui_gray_2]此项属性是角色抵御生化系异常的指标:\n
		%c[0,255,255,255]防护策略:\n
		%c[d_cyan] • %c[0,255,255,255]物品: %c[ui_gray_2]金霉素, 磺胺抗菌药, 解毒剂\n
		%c[d_cyan] • %c[0,255,255,255]装备: %c[ui_gray_2]防护服\腰带装备\护甲\神器\n</text>
	</string>
	<string id="ui_inv_fire_wound_protection">
		<text>%c[0,255,255,255]防弹性能\n
		%c[ui_gray_2]此项属性是角色护甲能安全吸收子弹或弹片动能的指标, 出于评估目的, 使用了国际公认的美国国家司法研究所(NIJ)系统:\n\n
		%c[d_cyan] • %c[ui_gray_2] 护甲等级表:\n
		%c[d_cyan] • %c[ui_gray_2] 无:%c[ui_gray_2] 9x18mm, .45 ACP, 12x76\n
		%c[d_cyan] • %c[ui_gray_2] 等级 I:%c[ui_gray_2] 9x18mm +P+, 9x19mm FMJ, 9x19mm JHP, 手雷弹片\n
		%c[d_cyan] • %c[ui_gray_2] 等级 IIA 和 II:%c[ui_gray_2] 9x18mm RG028, .45 HS, 5.7x28mm SS195, .357 HP, 12x76独头弹\n
		%c[d_cyan] • %c[ui_gray_2] 等级 IIIA:%c[ui_gray_2] 9x19mm AP, 5.45x39mm FMJ/EP, 5.56x45mm FMJ, 7.62x51mm北约弹, 9x39mm SP-5, 12x76镖弹\n
		%c[d_cyan] • %c[ui_gray_2] 等级 III:%c[ui_gray_2] 5.56x45mm EP/AP, 7.62x39mm FMJ/AP, 7.62x54mm ZN1/PP, 7.92x57mm毛瑟弹, 9x39mm SP-6, 12.7x55mm STs-130\n
		%c[d_cyan] • %c[ui_gray_2] 等级 IV:%c[ui_gray_2] 5.45x39mm AP, 7.62x51mm北约AP弹, 7.62x54mm AP/7H14, 7.92x57mm SA, .338拉普阿马格南, 12.7x55mm STs-130 VPS\n
		%c[d_cyan] • %c[ui_gray_2] 等级 V (外骨骼):%c[d_red] 军事机密\n
		%c[0,255,255,255]注意:\n
		%c[ui_gray_2]上述防护等级只涉及护甲的反穿透属性, 由于动能传递, 子弹的冲击仍然能够造成钝伤</text>
	</string>
	<string id="ui_inv_radiation_protection">
		<text>%c[0,255,255,255]辐射抗性\n
		%c[ui_gray_2]此项属性是角色抵御辐射的指标:\n
		%c[0,255,255,255]防护策略:\n
		%c[d_cyan] • %c[0,255,255,255]物品: %c[ui_gray_2]消辐宁, 抗辐射针, 碘化钾片, 辐射防护片, AI-2急救包, 科研用急救包, "重生"针剂, 科研用治疗针, 小型生存包\n
		%c[d_cyan] • %c[0,255,255,255]装备: %c[ui_gray_2]防护服\腰带装备\头盔或面罩\神器</text>
	</string>
	<string id="ui_inv_shock_protection">
		<text>%c[0,255,255,255]电击抗性\n
		%c[ui_gray_2]此项属性是角色抵御电系异常的指标:\n
		%c[0,255,255,255]防护策略:\n
		%c[d_cyan] • %c[0,255,255,255]物品: %c[ui_gray_2]防护服\腰带装备\护甲\神器\n</text>
	</string>
	<string id="ui_inv_telepatic_protection">
		<text>%c[0,255,255,255]灵能抗性\n
		%c[ui_gray_2]此项属性是角色抵御灵能场的指标:\n
		%c[0,255,255,255]防护策略:\n
		%c[d_cyan] • %c[0,255,255,255]物品: %c[ui_gray_2]依托拉嗪镇静药, 抗灵药, 安眠药, 大麻卷烟, 一包大麻\n</text>
	</string>
	<string id="ui_inv_wound_protection">
		<text>%c[0,255,255,255]撕裂抗性\n
		%c[ui_gray_2]此项属性代表了角色的护甲吸收和转移各种物理冲击的能力, 包括但不限于拳击, 踢击, 刺击, 割伤, 咬伤和灵能投掷的各种物体碎片\n
		%c[0,255,255,255]防护策略:\n
		%c[d_cyan] • %c[0,255,255,255]物品: %c[ui_gray_2]防护服\腰带装备\护甲\神器\n</text>
	</string>
