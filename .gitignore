# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 插件运行数据（模型、运行库、配置、日志均由插件在本地生成）
# 默认落 %LOCALAPPDATA%；只有放了 portable.txt 才写进插件目录。
plugins/ai_translate/assets/bin/
plugins/ai_translate/assets/models/
plugins/ai_translate/assets/logs/
plugins/ai_translate/assets/downloads/
plugins/ai_translate/assets/config.json
# 用户术语覆盖层：运行时生成，不属于随包内容
plugins/ai_translate/assets/glossary_user.json
plugins/ai_translate/assets/*.bak
# 便携模式开关（本机选择，不进仓库）
plugins/ai_translate/portable.txt

# 模型 / 运行库 / 压缩包
*.gguf
*.tar.gz
*.7z
*.rar
*.part

# 日志与临时文件
*.log
debug.log
*.tmp

# AI 助手 / 内部工作目录
.workbuddy/
reviews/
_audit_*

# 操作系统 / 编辑器
Thumbs.db
Desktop.ini
.DS_Store
*.swp
*~
*.lnk

# 本地备份（迭代前快照，不提交）
backup/

# 语料采集临时下载（压缩包/DB/克隆仓库）
tmp/

# Monorepo 构建暂存与 Python 打包产物
dist/staging/
build/
*.egg-info/

# 测试产物 / 本地会话（不提交）
.coverage
.sessions/
